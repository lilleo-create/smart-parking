{
  "name": "smart-parking-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "mobile:sync": "npm run build && cap sync",
    "android:open": "npm run mobile:sync && cap open android",
    "ios:open": "npm run mobile:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "leaflet": "1.9.4",
    "vue": "3.5.45",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@types/leaflet": "1.9.21",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vue-tsc": "3.2.5"
  }
}
