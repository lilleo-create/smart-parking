# Базовые настройки текста; уточнить для выбранных языков позже.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# В Markdown два пробела на конце строки могут означать перенос.
[*.md]
trim_trailing_whitespace = false
